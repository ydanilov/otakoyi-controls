{
  "schemaVersion": 1,
  "installation": {
    "id": "demo",
    "name": "Demo installation",
    "revision": 1
  },
  "targets": [
    {
      "id": "td",
      "name": "TouchDesigner",
      "protocol": "udp",
      "host": "auto",
      "port": 7000,
      "feedbackPort": 9000
    }
  ],
  "theme": {
    "mode": "dark",
    "primary": "#8DFF2E",
    "accent": "#3DD6FF"
  },
  "pults": [
    {
      "id": "lobby",
      "name": "Lobby wall",
      "defaultTarget": "td",
      "pages": [
        {
          "id": "live",
          "title": "Live",
          "controls": [
            {
              "id": "intensity",
              "type": "fader",
              "label": "Intensity",
              "address": "/wall/intensity",
              "default": 0.6,
              "grid": {
                "x": 0,
                "y": 0,
                "w": 2,
                "h": 6
              },
              "preset": "fader/brightness"
            },
            {
              "id": "speed",
              "type": "fader",
              "label": "Speed",
              "address": "/wall/speed",
              "grid": {
                "x": 2,
                "y": 0,
                "w": 2,
                "h": 6
              },
              "preset": "acme-speed"
            },
            {
              "id": "position",
              "type": "xy",
              "label": "Focus point",
              "address": "/wall/focus",
              "grid": {
                "x": 4,
                "y": 0,
                "w": 5,
                "h": 6
              }
            },
            {
              "id": "hue",
              "type": "knob",
              "label": "Hue shift",
              "address": "/wall/hue",
              "grid": {
                "x": 9,
                "y": 0,
                "w": 3,
                "h": 3
              },
              "preset": "knob/hue"
            },
            {
              "id": "audio",
              "type": "meter",
              "label": "Audio",
              "feedback": "/wall/audio/level",
              "grid": {
                "x": 9,
                "y": 3,
                "w": 1,
                "h": 3
              },
              "preset": "meter/audio"
            },
            {
              "id": "status",
              "type": "label",
              "label": "FPS",
              "feedback": "/sys/fps",
              "grid": {
                "x": 10,
                "y": 3,
                "w": 2,
                "h": 3
              },
              "preset": "label/fps"
            },
            {
              "id": "mode",
              "type": "segmented",
              "label": "Mode",
              "address": "/wall/mode",
              "options": [
                {
                  "label": "Ambient",
                  "value": "ambient"
                },
                {
                  "label": "React",
                  "value": "react"
                },
                {
                  "label": "Show",
                  "value": "show"
                }
              ],
              "grid": {
                "x": 0,
                "y": 6,
                "w": 6,
                "h": 2
              }
            },
            {
              "id": "logo",
              "type": "toggle",
              "label": "Logo",
              "address": "/wall/logo",
              "grid": {
                "x": 6,
                "y": 6,
                "w": 2,
                "h": 2
              }
            },
            {
              "id": "flash",
              "type": "button",
              "label": "Flash",
              "address": "/wall/flash",
              "grid": {
                "x": 8,
                "y": 6,
                "w": 2,
                "h": 2
              }
            },
            {
              "id": "blackout",
              "type": "holdToConfirm",
              "label": "Blackout",
              "address": "/wall/blackout",
              "grid": {
                "x": 10,
                "y": 6,
                "w": 2,
                "h": 2
              },
              "preset": "holdToConfirm/blackout"
            }
          ]
        },
        {
          "id": "scenes",
          "title": "Scenes",
          "controls": [
            {
              "id": "scene",
              "type": "sceneList",
              "label": "Scene",
              "address": "/scene",
              "crossfade": 2,
              "scenes": [
                {
                  "id": "morning",
                  "label": "Morning",
                  "value": 1
                },
                {
                  "id": "day",
                  "label": "Day",
                  "value": 2
                },
                {
                  "id": "evening",
                  "label": "Evening",
                  "value": 3
                },
                {
                  "id": "event",
                  "label": "Event",
                  "value": 4
                }
              ],
              "grid": {
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 8
              }
            },
            {
              "id": "pads",
              "type": "buttonGrid",
              "label": "Cues",
              "address": "/cue/{index}",
              "rows": 3,
              "cols": 4,
              "grid": {
                "x": 6,
                "y": 0,
                "w": 6,
                "h": 5
              },
              "preset": "buttonGrid/cues"
            },
            {
              "id": "tint",
              "type": "colorPicker",
              "label": "Tint",
              "address": "/wall/tint",
              "swatches": ["#C6FF3D", "#3DD6FF", "#FF3D8B", "#FFFFFF"],
              "grid": {
                "x": 6,
                "y": 5,
                "w": 6,
                "h": 3
              }
            }
          ]
        }
      ]
    },
    {
      "id": "hall",
      "name": "Conference hall",
      "defaultTarget": "td",
      "pages": [
        {
          "id": "stage",
          "title": "Stage",
          "controls": [
            {
              "id": "backdrop",
              "type": "sceneList",
              "label": "Backdrop",
              "address": "/hall/backdrop",
              "scenes": [
                {
                  "id": "walkin",
                  "label": "Walk-in",
                  "value": 1
                },
                {
                  "id": "keynote",
                  "label": "Keynote",
                  "value": 2
                },
                {
                  "id": "break",
                  "label": "Break",
                  "value": 3
                },
                {
                  "id": "sponsors",
                  "label": "Sponsors",
                  "value": 4
                }
              ],
              "grid": {
                "x": 0,
                "y": 0,
                "w": 6,
                "h": 6
              }
            },
            {
              "id": "brightness",
              "type": "fader",
              "label": "Brightness",
              "address": "/hall/brightness",
              "default": 0.8,
              "grid": {
                "x": 6,
                "y": 0,
                "w": 3,
                "h": 6
              },
              "preset": "fader/brightness"
            },
            {
              "id": "reactivity",
              "type": "knob",
              "label": "Audio reactivity",
              "address": "/hall/reactivity",
              "default": 0.5,
              "grid": {
                "x": 9,
                "y": 0,
                "w": 3,
                "h": 6
              },
              "preset": "knob/amount"
            },
            {
              "id": "hall-blackout",
              "type": "holdToConfirm",
              "label": "Blackout",
              "address": "/hall/blackout",
              "grid": {
                "x": 0,
                "y": 6,
                "w": 12,
                "h": 2
              },
              "preset": "holdToConfirm/blackout"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "id": "acme-speed",
      "type": "fader",
      "label": "Acme wall speed",
      "description": "Custom studio preset: 0–4× in 0.25 steps",
      "props": {
        "min": 0,
        "max": 4,
        "step": 0.25,
        "default": 1,
        "unit": "×"
      }
    }
  ]
}
