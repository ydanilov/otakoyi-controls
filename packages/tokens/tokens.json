{
  "$description": "Base tokens of the pult design system. Studio-owned; clients never change these. Brand tokens come from the installation config and are merged at runtime by createTheme().",
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radius": { "none": 0, "sm": 8, "md": 12, "lg": 22, "xl": 28, "full": 9999 },
  "stroke": { "hairline": 1, "default": 1.5, "strong": 2, "focus": 3 },
  "touch": { "min": 44, "comfortable": 56, "large": 72 },
  "motion": {
    "duration": { "instant": 80, "fast": 150, "base": 220, "slow": 360 },
    "spring": { "damping": 22, "stiffness": 260, "mass": 1 }
  },
  "font": {
    "family": { "sans": "Inter", "mono": "JetBrains Mono" },
    "weight": { "regular": "400", "medium": "500", "semibold": "600", "bold": "700" },
    "size": { "xs": 11, "sm": 13, "md": 15, "lg": 17, "xl": 22, "2xl": 28, "display": 40 },
    "lineHeight": { "xs": 14, "sm": 18, "md": 20, "lg": 24, "xl": 28, "2xl": 34, "display": 46 },
    "tracking": { "overline": 0.08 }
  },
  "control": {
    "faderTrack": 56,
    "faderThumb": 12,
    "knob": 88,
    "knobArc": 6,
    "xyDot": 28,
    "meterWidth": 12,
    "holdRing": 4,
    "gridGap": 8,
    "pultPhoneGap": 18,
    "pultPhonePadX": 16,
    "pultPhonePadTop": 12,
    "pultPhonePadBottom": 12,
    "pultTabletGap": 16,
    "pultTabletPadX": 20,
    "pultTabletPadY": 10,
    "faderRail": 8,
    "faderLine": 4,
    "faderCapLong": 60,
    "faderCapShort": 44,
    "jogHousing": 48,
    "padRegularW": 150,
    "padRegularH": 88,
    "padCompactW": 104,
    "padCompactH": 64,
    "picturePadRegular": 168,
    "picturePadCompact": 120,
    "padRadius": 14,
    "knobCompactScale": 0.7
  },
  "color": {
    "dark": {
      "background": "#22252C",
      "surface": "#282C34",
      "surfaceRaised": "#2F333C",
      "border": "#3A3F49",
      "text": "#E3E6EC",
      "textMuted": "#8B919D",
      "overlay": "#000000B3",
      "sheet": "#1C1C1E",
      "sheetGrabber": "#4F4F51",
      "sheetButton": "#303032"
    },
    "light": {
      "background": "#E4E8EE",
      "surface": "#EAEDF2",
      "surfaceRaised": "#F1F3F7",
      "border": "#D2D7DF",
      "text": "#20242B",
      "textMuted": "#636A77",
      "overlay": "#0000004D",
      "sheet": "#F2F2F7",
      "sheetGrabber": "#C7C7CC",
      "sheetButton": "#E3E3E8"
    },
    "status": {
      "$description": "Never overridden by a brand: operators must recognise these on every pult.",
      "online": "#5CF27A",
      "warning": "#FFB02E",
      "critical": "#FF4D5E",
      "offline": "#6B717D",
      "studio": "#9B7BFF"
    }
  },
  "elevation": {
    "$description": "Neumorphic depth (ADR-013 addendum). Mirrors the Figma `elevation/*` variables and the Neu/* + Glow/* effect styles. Raised = interactive / top-level, inset = active / pressed / bed under a control, flat = info nested in a card. Glow only on lit values and while pressed.",
    "dark": {
      "shadow": "#08090D80",
      "shadowContact": "#08090D59",
      "highlight": "#FFFFFF05",
      "edgeLight": "#FFFFFF08",
      "edgeDark": "#05060840",
      "insetShadow": "#05060899",
      "insetHighlight": "#FFFFFF0D"
    },
    "light": {
      "shadow": "#8E98AA73",
      "shadowContact": "#8E98AA4D",
      "highlight": "#FFFFFFCC",
      "edgeLight": "#FFFFFF99",
      "edgeDark": "#8E98AA26",
      "insetShadow": "#8E98AA80",
      "insetHighlight": "#FFFFFFE6"
    },
    "effects": {
      "$description": "Figma effect styles 1:1 (Neu/Raised, Neu/Raised SM, Neu/Inset, Neu/Pressed, Glow/Primary, Glow/Primary Active). Light comes from above: shadows fall straight down, highlights sit on top.",
      "raised": [
        { "x": 0, "y": 14, "blur": 32, "spread": -6, "color": "shadow" },
        { "x": 0, "y": 2, "blur": 4, "spread": 0, "color": "shadowContact" },
        { "x": 0, "y": -4, "blur": 16, "spread": -2, "color": "highlight" },
        { "x": 0, "y": 1, "blur": 0, "spread": 0, "color": "edgeLight", "inset": true },
        { "x": 0, "y": -2, "blur": 8, "spread": 0, "color": "edgeDark", "inset": true }
      ],
      "raisedSm": [
        { "x": 0, "y": 6, "blur": 16, "spread": -3, "color": "shadow" },
        { "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "shadowContact" },
        { "x": 0, "y": -2, "blur": 8, "spread": -1, "color": "highlight" },
        { "x": 0, "y": 1, "blur": 0, "spread": 0, "color": "edgeLight", "inset": true },
        { "x": 0, "y": -1, "blur": 5, "spread": 0, "color": "edgeDark", "inset": true }
      ],
      "inset": [
        { "x": 0, "y": 3, "blur": 8, "spread": 0, "color": "insetShadow", "inset": true },
        { "x": 0, "y": -1, "blur": 4, "spread": 0, "color": "insetHighlight", "inset": true }
      ],
      "pressed": [
        { "x": 0, "y": 2, "blur": 6, "spread": 0, "color": "insetShadow", "inset": true },
        { "x": 0, "y": -1, "blur": 3, "spread": 0, "color": "insetHighlight", "inset": true }
      ],
      "glow": [
        { "x": 0, "y": 0, "blur": 8, "spread": 0, "color": "glow" },
        { "x": 0, "y": 0, "blur": 2, "spread": 0, "color": "glow" }
      ],
      "glowActive": [
        { "x": 0, "y": 0, "blur": 12, "spread": 0, "color": "glow" },
        { "x": 0, "y": 0, "blur": 3, "spread": 0, "color": "glow" }
      ]
    }
  },
  "touchLight": {
    "$description": "Touch light (Figma `Touch Light` 134:795, board 134:15404), per Apple Liquid Glass: the touched element illuminates from within, starting under the fingertip. White only, clipped to the touched element, never spilling onto the track or around it. Faders, knobs, thumbstick and jog wheel: the thumb / disc / stick / wheel itself gets a radial white gradient (`innerOpacity` at the touch point → 0). Pads, buttons, toggles, segments, quick actions, XY pad: halo + core. Sizes are px or fractions of the surface width; durations in ms.",
    "color": "#FFFFFF",
    "innerOpacity": 0.16,
    "haloOpacity": 0.07,
    "coreOpacity": 0.12,
    "padScale": 0.75,
    "haloMax": 112,
    "coreScale": 0.5,
    "fromScale": 0.6,
    "inMs": 120,
    "outMs": 260
  },
  "debug": {
    "$description": "Developer debug overlay (Figma Debug Tag / Debug HUD): mono text on a dark scrim with an amber (status warning) hairline. Same in both modes.",
    "tagBackground": "#000000B8",
    "hudBackground": "#000000D1"
  },
  "brandDefaults": {
    "$description": "The Otakoyi mode of the Figma Brand collection (brand/*); checked against figma/brand-modes.json.",
    "primary": "#8DFF2E",
    "onPrimary": "#11140F",
    "primaryPressed": "#62C41B",
    "primarySubtle": "#24301F",
    "accent": "#3DD6FF",
    "onAccent": "#0D1418",
    "primarySignalLight": "#4F9116",
    "mode": "dark",
    "font": "Inter"
  }
}
